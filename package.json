{
  "name": "jt-digital-world-website",
  "private": true,
  "type": "module",
  "description": "JT Digital World static website build for Cloudflare Pages",
  "scripts": {
    "build:website": "node scripts/build-site.mjs",
    "test:jt-cloud": "node --test scripts/test-jt-cloud-drive.mjs scripts/test-jt-cloud-api.mjs && node scripts/test-jeff-api.mjs",
    "test:jeff-context": "node --test scripts/test-jeff-project-context.mjs",
    "test:jt-workspace": "node --test scripts/test-jt-workspace-shell.mjs",
    "test:jt-design": "node --test scripts/test-jt-design-image-import.mjs scripts/test-jt-design-templates.mjs scripts/test-jt-design-precision.mjs",
    "test:jt-workspace-dashboard": "node --test scripts/test-jt-workspace-dashboard.mjs",
    "test:jt-code": "node --test scripts/test-jt-code-checks.mjs",
    "test:jeff-ai-library": "node --test scripts/test-jeff-ai-library.mjs",
    "test:jt-cloud-files": "node --test scripts/test-jt-cloud-file-controls.mjs",
    "test:jeff-workspace": "node --test scripts/test-jt-ai-workspace-polish.mjs",
    "test:jt-motion": "node --test scripts/test-jt-motion-timeline.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
