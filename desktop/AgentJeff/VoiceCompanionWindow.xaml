<Window x:Class="AgentJeff.VoiceCompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Jeff · Voice Companion" Width="420" Height="300"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        Background="#090B16" Foreground="#F4F5FF">
  <Border BorderBrush="#929BFF" BorderThickness="1" CornerRadius="20" Padding="22" Background="#11152A">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel>
        <Border Background="#252A4A" CornerRadius="9" Padding="9" DockPanel.Dock="Left"><TextBlock Text="JT" FontSize="17" FontWeight="Bold" Foreground="#AEB5FF"/></Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Agent Jeff" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="VOICE COMPANION" FontSize="10" Foreground="#A4A9C5" Margin="0,3,0,0"/></StackPanel>
        <Button Content="×" Click="Hide_Click" Width="34" Height="34" HorizontalAlignment="Right" Background="#292F50" Foreground="White" BorderThickness="0" FontSize="18"/>
      </DockPanel>
      <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18">
        <TextBlock Text="Your desktop companion is ready" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
        <TextBlock Text="This panel stays above normal windows only while your Windows session is unlocked. It cannot appear on the secure Windows sign-in screen." Foreground="#B6BAD1" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" LineHeight="21"/>
        <TextBlock Text="Voice identity verification is not enabled yet." Foreground="#FFD38A" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
      </StackPanel>
      <Button Grid.Row="2" Content="STOP &amp; HIDE COMPANION" Click="Hide_Click" Height="42" Background="#929BFF" Foreground="#101326" BorderThickness="0" FontWeight="SemiBold"/>
    </Grid>
  </Border>
</Window>